{
  "displayName": "Wiz Lights",
  "name": "homebridge-wiz-scene-controller",
  "version": "3.0.0",
  "author": "jaspersnowolf",
  "contributors": [
    "dalemugford"
  ],
  "description": "Homebridge plugin for Wiz bulbs over UDP. Exposes each bulb as a native HomeKit Lightbulb with Hue, Saturation, Brightness, ColorTemperature, and Adaptive Lighting.",
  "license": "MIT",
  "homepage": "https://github.com/dalemugford/homebridge-wiz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dalemugford/homebridge-wiz.git"
  },
  "bugs": {
    "url": "https://github.com/dalemugford/homebridge-wiz/issues"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "engines": {
    "node": "^18.17.0 || ^20.9.0 || ^22.0.0 || ^24.0.0",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "keywords": [
    "homebridge-plugin",
    "wiz",
    "homekit",
    "lightbulb",
    "adaptive-lighting"
  ],
  "dependencies": {
    "getmac": "^5.17.0",
    "internal-ip": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^18.16.20",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.45.0",
    "homebridge": "^1.6.0",
    "nodemon": "^2.0.22",
    "rimraf": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5"
  }
}
